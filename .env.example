# Copy to .env.local for `pnpm dev`, or to .env for Docker Compose.
# Never commit real secrets.

# SQLite file and recipe photos (created automatically)
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# URL phones actually use (localhost, LAN, or Netbird MagicDNS)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Two household accounts (seeded on first boot; same permissions)
PLANNER_USERNAME=planner
PLANNER_PASSWORD=change-me
PLANNER_DISPLAY_NAME=Planner
SHOPPER_USERNAME=shopper
SHOPPER_PASSWORD=change-me
SHOPPER_DISPLAY_NAME=Shopper

# Optional import LLM. Leave empty — app works without it.
# Ollama example: LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
